{
  "name": "giganotes",
  "version": "0.1.0",
  "description": "Local-first forum-style notes app",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build:app": "npm run build && npm run build:server",
    "app": "npm run build:app && electron .",
    "dist": "npm run build:app && electron-builder --win portable"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "sharp@0.35.5": true,
    "ffmpeg-static@5.3.0": true
  },
  "build": {
    "appId": "com.giganotes.app",
    "productName": "GigaNotes",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "dist-server/**",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
